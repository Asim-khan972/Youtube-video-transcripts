{
    "name": "youtube-video-transcript",
    "version": "1.0.0",
    "description": "Fetch transcript from a YouTube video",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rollup -c",
        "format": "prettier --write 'src/**/*.ts'",
        "lint": "eslint .",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "author": "Asim khan <asimabas95@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Asim-khan972/Youtube-video-transcripts.git"
    },
    "keywords": [
        "youtube",
        "transcript",
        "captions",
        "subtitles",
        "video",
        "scraper"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/jest": "^30.0.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "https-proxy-agent": "^7.0.6",
        "husky": "^9.1.7",
        "jest": "^30.0.5",
        "lint-staged": "^16.1.5",
        "nock": "^14.0.10",
        "prettier": "^3.6.2",
        "rollup": "^4.46.4",
        "rollup-plugin-typescript": "^1.0.1",
        "rollup-plugin-typescript2": "^0.36.0",
        "ts-jest": "^29.4.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.50.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
